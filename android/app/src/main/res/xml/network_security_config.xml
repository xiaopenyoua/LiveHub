<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 直播流大量走 http（斗鱼 CDN、虎牙 FLV），必须放行明文；仅用于媒体拉流，不做账号数据传输 -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
